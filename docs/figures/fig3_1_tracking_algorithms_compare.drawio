  <diagram id="tracking-compare" name="Page-1">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="DeepSORT、ByteTrack 与 CenterTrack 的核心跟踪流程对比" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=SimHei;fontSize=24;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="110" y="18" width="1060" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="三种方法共享检测器输出，但在关联依据、匹配策略和轨迹更新机制上存在明显差异；本图采用窄版三列布局，便于插入论文后保持可读字号。" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=SimSun;fontSize=13;fontColor=#404040;" vertex="1" parent="1">
          <mxGeometry x="80" y="56" width="1120" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="input" value="共享输入：检测器输出边界框、类别与置信度" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#F2F2F2;fontFamily=SimSun;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="170" y="100" width="940" height="56" as="geometry"/>
        </mxCell>

        <mxCell id="col1" value="算法1  DeepSORT" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#7F7F7F;fillColor=none;dashed=1;dashPattern=8 8;fontFamily=SimHei;fontSize=16;fontStyle=1;align=left;spacingLeft=12;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="210" width="300" height="770" as="geometry"/>
        </mxCell>
        <mxCell id="d1" value="轨迹状态预测&#xa;卡尔曼滤波" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=SimSun;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="110" y="270" width="200" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="d2" value="外观特征提取&#xa;Re-ID 嵌入向量" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#F2F2F2;fontFamily=SimSun;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="110" y="380" width="200" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="d3" value="级联匹配&#xa;马氏距离 + 余弦距离 + 匈牙利算法" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=SimSun;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="490" width="220" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="d4" value="轨迹更新&#xa;确认、失活、删除与新建轨迹" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#F2F2F2;fontFamily=SimSun;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="620" width="220" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="d-note" value="关键差异：引入外观特征用于遮挡恢复，身份保持能力较强，但在红外弱纹理场景下依赖 Re-ID 区分度。" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;strokeColor=#808080;fillColor=#FFFFFF;fontFamily=SimSun;fontSize=12;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="85" y="760" width="250" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="col2" value="算法2  ByteTrack" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#7F7F7F;fillColor=none;dashed=1;dashPattern=8 8;fontFamily=SimHei;fontSize=16;fontStyle=1;align=left;spacingLeft=12;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="390" y="210" width="300" height="770" as="geometry"/>
        </mxCell>
        <mxCell id="b1" value="轨迹状态预测&#xa;卡尔曼滤波" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=SimSun;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="440" y="270" width="200" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="b2" value="检测框分组&#xa;按置信度划分高分与低分" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#F2F2F2;fontFamily=SimSun;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="440" y="380" width="200" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="b3" value="两轮 IoU 关联&#xa;先高分匹配，再低分补匹配" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=SimSun;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="430" y="490" width="220" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="b4" value="轨迹更新&#xa;尽量恢复被遮挡或低分目标" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#F2F2F2;fontFamily=SimSun;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="430" y="620" width="220" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="b-note" value="关键差异：不使用 Re-ID，仅依赖 IoU 和双阈值二次关联，计算开销较低，适合红外外观特征不足和嵌入式部署场景。" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;strokeColor=#808080;fillColor=#FFFFFF;fontFamily=SimSun;fontSize=12;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="415" y="760" width="250" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="col3" value="算法3  CenterTrack" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#7F7F7F;fillColor=none;dashed=1;dashPattern=8 8;fontFamily=SimHei;fontSize=16;fontStyle=1;align=left;spacingLeft=12;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="720" y="210" width="300" height="770" as="geometry"/>
        </mxCell>
        <mxCell id="c1" value="联合输入&#xa;当前帧与前一帧热力图" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=SimSun;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="770" y="270" width="200" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="网络预测&#xa;中心点、尺寸与偏移量" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#F2F2F2;fontFamily=SimSun;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="770" y="380" width="200" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="中心点关联&#xa;按跨帧偏移完成轨迹延续" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=SimSun;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="760" y="490" width="220" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="c4" value="直接输出结果&#xa;检测框与轨迹 ID" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#F2F2F2;fontFamily=SimSun;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="760" y="620" width="220" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="c-note" value="关键差异：将检测与关联放在同一网络中完成，不显式使用 Re-ID 与二次匹配，但对中心偏移预测精度和时序输入质量更敏感。" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;strokeColor=#808080;fillColor=#FFFFFF;fontFamily=SimSun;fontSize=12;align=left;spacingLeft=10;spacingRight=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="745" y="760" width="250" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="out-note" value="统一输出：连续轨迹、稳定 ID 与状态更新结果" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#F2F2F2;fontFamily=SimSun;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
